pipeline {
    agent any
    stages {
         stage('DEV') {
            steps {
                echo "Completed Dev...."
            }
        }
        stage('BUILD') {
            steps {
                echo "Build my app...."
            }
        }
         stage('TEST') {
            steps {
                echo "Test my app...."
            }
        }
        stage('DEPLOY') {
            steps {
                echo "Deploy my app...."
            }
        }
    }
}
